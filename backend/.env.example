# Copy this to .env and fill in your values

# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Cloud (from cloud.qdrant.io - Free tier available)
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Neon Postgres (from neon.tech - Free tier available)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Secret (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-this

# Allowed Origins (your frontend URLs)
ALLOWED_ORIGINS=["http://localhost:3000","https://your-username.github.io"]
